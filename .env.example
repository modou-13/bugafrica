# Copie ce fichier en ".env" et remplis les valeurs. Ne commite JAMAIS le vrai .env.

DB_NAME=bugafrica
DB_USERNAME=bugafrica
DB_PASSWORD=change-moi-mot-de-passe-db
DB_ROOT_PASSWORD=change-moi-mot-de-passe-root

# Au moins 32 caractères. Génère-le avec : openssl rand -base64 48
JWT_SECRET=

JWT_EXPIRATION_MS=86400000

# Adresse(s) du frontend autorisée(s), séparées par des virgules
CORS_ORIGINS=http://localhost:4200

SWAGGER_ENABLED=true
